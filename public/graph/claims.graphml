    <edge id="C0258" source="40-hz-light-flicker-1acxixc" target="native-gamma-oscillations-plaque-load-and-microg-1ea02nk"><data key="e_claim_id">C0258</data><data key="e_predicate">modulates</data><data key="e_refs">125</data><data key="e_status">contested</data><data key="e_evidence">animal-interventional</data><data key="e_level">circuit</data><data key="e_species">mouse</data><data key="e_section">v0-7-molecular-subcellular-convergence</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_hypothesis">H-gamma-40hz-p2</data><data key="e_hypothesis_group">H-gamma-40hz</data><data key="e_parameters">{&quot;method&quot;:&quot;large-scale recordings in visual cortex and hippocampus of model mice&quot;,&quot;entrainment&quot;:&quot;did not entrain native gamma oscillations (negative)&quot;,&quot;behaviour&quot;:&quot;the mice avoided the flicker&quot;,&quot;endpoints&quot;:&quot;plaques and microglia not meaningfully changed (negative)&quot;}</data></edge>
    <edge id="C0259" source="unmeasured-joins-in-the-40-hz-chain-19b6nlw" target="the-40-hz-drive-to-amyloid-convergence-claim-18n60p9"><data key="e_claim_id">C0259</data><data key="e_predicate">confounds</data><data key="e_refs">123;124;125</data><data key="e_status">inferred</data><data key="e_evidence">inferred</data><data key="e_level">molecular</data><data key="e_species">n/a</data><data key="e_section">v0-7-molecular-subcellular-convergence</data><data key="e_volume">v0</data><data key="e_synthesis">true</data><data key="e_parameters">{&quot;joins&quot;:&quot;drive to entrainment, entrainment to glial state, glial state to clearance, clearance to plaque load&quot;,&quot;mismatch&quot;:&quot;the glymphatic study supplies a mechanism for clearance while the counter-study attacks the first join&quot;,&quot;settling_experiment&quot;:&quot;a replication reporting entrainment measured invasively and amyloid in the same animals, with flicker aversion controlled&quot;}</data></edge>
    <edge id="C0260" source="assay-preparation-species-and-direction-of-chang-0550ccm" target="comparability-of-edges-into-a-molecular-endpoint-19n23cw"><data key="e_claim_id">C0260</data><data key="e_predicate">required_for</data><data key="e_refs">110;111;116;118;168;141;190;147</data><data key="e_status">inferred</data><data key="e_evidence">inferred</data><data key="e_level">molecular</data><data key="e_species">n/a</data><data key="e_section">v0-7-molecular-subcellular-convergence</data><data key="e_volume">v0</data><data key="e_synthesis">true</data><data key="e_parameters">{&quot;collapsed_referents&quot;:&quot;secreted protein in a mouse slice, translated protein after eEF2K deactivation in mouse cortex, a human genotype, and a structural binding claim about the receptor&quot;,&quot;strongest_form_of_convergence_evidence&quot;:&quot;two drives whose effects are abolished by the same intervention in the same preparation&quot;,&quot;examples&quot;:&quot;shared NMDA-receptor-activation requirement across four unrelated compounds in mice, the cholinergic lesion that abolishes device-driven map plasticity in rats, and the D-cycloserine addition that multiplied an iTBS clinical effect in humans&quot;,&quot;additional_requirement&quot;:&quot;hold the gating relation separately, since plasticity is conditional on a modulatory third factor&quot;}</data></edge>
    <edge id="C0265" source="consistent-phase-relation-between-two-oscillatin-0hwxbhb" target="effective-connectivity-between-the-groups-09sk8np"><data key="e_claim_id">C0265</data><data key="e_predicate">gates</data><data key="e_refs">128</data><data key="e_status">supported</data><data key="e_evidence">consensus</data><data key="e_level">circuit</data><data key="e_species">n/a</data><data key="e_section">v0-8-circuits-networks-neuromodulators</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;account&quot;:&quot;active neuronal groups oscillate, so excitability fluctuates rhythmically, opening and closing short windows for input and output&quot;,&quot;condition&quot;:&quot;two groups influence one another effectively only when their windows align at a consistent phase relation&quot;,&quot;corollary&quot;:&quot;a changing pattern of coherence is a changing effective connectivity, reconfigurable on cognitive timescales&quot;,&quot;status_of_evidence&quot;:&quot;theory, which licenses entrainment-style intervention&quot;}</data></edge>
    <edge id="C0266" source="ongoing-network-state-at-the-moment-of-stimulati-03dmstz" target="efficacy-of-an-applied-oscillatory-drive-0oq7wzk"><data key="e_claim_id">C0266</data><data key="e_predicate">confounds</data><data key="e_refs">37;44;53</data><data key="e_status">inferred</data><data key="e_evidence">inferred</data><data key="e_level">circuit</data><data key="e_species">ferret;macaque</data><data key="e_section">v0-8-circuits-networks-neuromodulators</data><data key="e_volume">v0</data><data key="e_synthesis">true</data><data key="e_parameters">{&quot;interaction_term&quot;:&quot;efficacy is a function of the applied drive and the ongoing state jointly, not of the drive alone&quot;,&quot;endogenous_fields&quot;:&quot;about 2-4 mV/mm in ferret cortex during physiological activity&quot;,&quot;state_dependence&quot;:&quot;tACS entrained weakly locked neurons and often reduced phase locking in neurons already strongly locked&quot;,&quot;resonance&quot;:&quot;frequency-specific enhancement largest when stimulation frequency matched the network's intrinsic rhythm&quot;,&quot;corpus_gap&quot;:&quot;no human study measuring imposed phase at the single-neuron level&quot;}</data></edge>
    <edge id="C0267" source="high-frequency-extracellular-stimulation-of-intr-1y9ol72" target="information-transmitted-by-the-stimulated-nucleu-1shmzgu"><data key="e_claim_id">C0267</data><data key="e_predicate">inhibits</data><data key="e_refs">133</data><data key="e_status">contested</data><data key="e_evidence">computational</data><data key="e_level">circuit</data><data key="e_species">n/a</data><data key="e_section">v0-8-circuits-networks-neuromodulators</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_hypothesis">H-dbs-mechanism-p1</data><data key="e_hypothesis_group">H-dbs-mechanism</data><data key="e_parameters">{&quot;model_result&quot;:&quot;high-frequency stimulation forces output spiking into a regular, essentially variance-free pattern, so the cell keeps firing but stops transmitting information&quot;,&quot;what_it_reconciles&quot;:&quot;clinical benefit requires high frequency, and the clinical picture resembles a lesion even though axonal output is being driven&quot;,&quot;locus_of_therapy&quot;:&quot;removal of pathological patterning, not a change of mean rate&quot;}</data></edge>
    <edge id="C0268" source="high-frequency-deep-brain-stimulation-052mwno" target="efferent-axons-with-antidromic-recruitment-of-co-00jt5j3"><data key="e_claim_id">C0268</data><data key="e_predicate">activates</data><data key="e_refs">133</data><data key="e_status">contested</data><data key="e_evidence">computational</data><data key="e_level">circuit</data><data key="e_species">n/a</data><data key="e_section">v0-8-circuits-networks-neuromodulators</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_hypothesis">H-dbs-mechanism-p2</data><data key="e_hypothesis_group">H-dbs-mechanism</data><data key="e_parameters">{&quot;rival_pole&quot;:&quot;the opposite of silencing: excitation of efferent axons and antidromic cortical recruitment, with network-level desynchronisation as a related variant&quot;,&quot;adjudication&quot;:&quot;the dispute is unadjudicated&quot;,&quot;what_outcome_data_cannot_do&quot;:&quot;both accounts predict benefit at high frequency&quot;}</data></edge>
    <edge id="C0269" source="dbs-pulses-in-the-subthalamic-nucleus-1k75ppv" target="evoked-resonant-neural-activity-within-the-nucle-01fay8w"><data key="e_claim_id">C0269</data><data key="e_predicate">activates</data><data key="e_refs">134</data><data key="e_status">contested</data><data key="e_evidence">human-interventional</data><data key="e_level">circuit</data><data key="e_species">human</data><data key="e_section">v0-8-circuits-networks-neuromodulators</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_hypothesis">H-dbs-mechanism-p2</data><data key="e_hypothesis_group">H-dbs-mechanism</data><data key="e_parameters">{&quot;recordings&quot;:&quot;human intraoperative and chronic recordings&quot;,&quot;response&quot;:&quot;a large, focal resonant response within the subthalamic nucleus&quot;,&quot;topography&quot;:&quot;largest in the dorsal STN, the clinically preferred target&quot;,&quot;anaesthesia&quot;:&quot;present under general anaesthesia&quot;,&quot;clinical&quot;:&quot;associated with better clinical performance&quot;,&quot;limit&quot;:&quot;a stimulation-locked population response that does not measure information content&quot;}</data></edge>
