    <edge id="C0525" source="origins-terminations-and-routing-of-autonomic-pr-0cirtwj" target="sckan-curated-ontology-backed-structural-connect-1piqs1c"><data key="e_claim_id">C0525</data><data key="e_predicate">measured_by</data><data key="e_refs">155</data><data key="e_status">supported</data><data key="e_evidence">consensus</data><data key="e_level">systemic</data><data key="e_species">human;rat;mouse</data><data key="e_section">v0-15-from-text-to-graph</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;sources&quot;:&quot;expert input, published literature, textbooks and SPARC datasets&quot;,&quot;use&quot;:&quot;generates the SPARC portal's connectivity maps&quot;,&quot;limit&quot;:&quot;population-level structural connectivity, not physiology - it says that a population projects by a given route, not what a stimulation train does to that population's firing&quot;}</data></edge>
    <edge id="C0526" source="receptor-subunit-or-channel-isoform-as-an-entity-11sv4lz" target="a-protein-ontology-0vj38fs"><data key="e_claim_id">C0526</data><data key="e_predicate">measured_by</data><data key="e_refs">215;216;217</data><data key="e_status">inferred</data><data key="e_evidence">inferred</data><data key="e_level">molecular</data><data key="e_section">v0-15-from-text-to-graph</data><data key="e_volume">v0</data><data key="e_synthesis">true</data><data key="e_parameters">{&quot;finding&quot;:&quot;this volume's corpus contains no reference describing one, so the protein slot is named but unanchored while anatomy, cell type, molecular function and chemical entity all have anchors&quot;}</data></edge>
    <edge id="C0527" source="stimulation-protocol-and-device-parameter-layer-1me49oc" target="reporting-standards-and-repositories-that-supply-1en7ws5"><data key="e_claim_id">C0527</data><data key="e_predicate">measured_by</data><data key="e_refs">79;193</data><data key="e_status">inferred</data><data key="e_evidence">inferred</data><data key="e_level">systemic</data><data key="e_section">v0-15-from-text-to-graph</data><data key="e_volume">v0</data><data key="e_synthesis">true</data><data key="e_parameters">{&quot;finding&quot;:&quot;no ontology in this volume's corpus covers stimulation protocols or device parameters adequately&quot;,&quot;rates&quot;:&quot;66 items in five groups - participants, stimulator, electrodes, current, procedure - with a 26-item essential subset, from a three-round Delphi study with 38 experts&quot;,&quot;intus&quot;:&quot;an open table of ultrasound parameters and outcomes whose own authors name incomplete parameter reporting as a limit&quot;,&quot;consequence&quot;:&quot;a protocol module has to be authored rather than reused, with a 'not reported' null distinct from zero in every slot&quot;}</data></edge>
    <edge id="C0528" source="automatically-extracted-subject-predicate-object-08xmo30" target="a-mechanism-claim-used-as-a-fact-in-a-knowledge-1tfhut7"><data key="e_claim_id">C0528</data><data key="e_predicate">confounds</data><data key="e_refs">220</data><data key="e_status">inferred</data><data key="e_evidence">inferred</data><data key="e_level">systemic</data><data key="e_section">v0-15-from-text-to-graph</data><data key="e_volume">v0</data><data key="e_synthesis">true</data><data key="e_parameters">{&quot;source&quot;:&quot;predications extracted by SemRep from all of PubMed&quot;,&quot;problem&quot;:&quot;a mined triple inherits the sentence's ambiguity rather than the study's design&quot;,&quot;consequence&quot;:&quot;the argument for curating claims by hand&quot;}</data></edge>
