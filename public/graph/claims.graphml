    <edge id="C0516" source="the-reflex-framing-of-vagal-control-of-splenic-t-0i2tqx6" target="the-therapeutic-claim-that-vagal-stimulation-sup-0y5an2x"><data key="e_claim_id">C0516</data><data key="e_predicate">required_for</data><data key="e_refs">149;151</data><data key="e_status">inferred</data><data key="e_evidence">inferred</data><data key="e_level">systemic</data><data key="e_species">rat;mouse</data><data key="e_section">v0-14-open-questions</data><data key="e_volume">v0</data><data key="e_synthesis">true</data><data key="e_parameters">{&quot;inference&quot;:&quot;the therapeutic claim survives either framing; only the reflex framing licenses an edge labelled reflex&quot;,&quot;undisputed&quot;:&quot;the molecular chain&quot;,&quot;disputed&quot;:&quot;the wiring diagram and the word reflex&quot;,&quot;settling_test&quot;:&quot;splenic nerve recording during physiological endotoxaemia with and without vagotomy&quot;}</data></edge>
