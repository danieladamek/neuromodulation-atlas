    <edge id="C0518" source="a-recorded-dose-parameter-set-travelling-with-th-18dn1hl" target="resolution-of-an-apparent-mechanism-dispute-into-10twyjt"><data key="e_claim_id">C0518</data><data key="e_predicate">required_for</data><data key="e_refs">84;146;171</data><data key="e_status">inferred</data><data key="e_evidence">inferred</data><data key="e_level">systemic</data><data key="e_section">v0-14-open-questions</data><data key="e_volume">v0</data><data key="e_synthesis">true</data><data key="e_parameters">{&quot;inference&quot;:&quot;several disputes resolve into dose rather than mechanism once parameters are recorded, which is visible only if the parameter set travels with the claim&quot;,&quot;instances&quot;:&quot;microbubble dose in barrier-opening inflammation; waveform in taVNS engagement; setting and endpoint in the ketamine-versus-ECT comparison&quot;}</data></edge>
