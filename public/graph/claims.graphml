    <edge id="C0220" source="between-person-response-variability-to-plasticit-085vux0" target="direction-of-the-after-effect-of-pas-anodal-tdcs-1sad5rv"><data key="e_claim_id">C0220</data><data key="e_predicate">confounds</data><data key="e_refs">204</data><data key="e_status">contested</data><data key="e_evidence">human-interventional</data><data key="e_level">cellular</data><data key="e_species">human</data><data key="e_section">v0-6-cellular-responses</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_hypothesis">H-tdcs-plasticity-p3</data><data key="e_hypothesis_group">H-tdcs-plasticity</data><data key="e_parameters">{&quot;n&quot;:&quot;56 healthy people&quot;,&quot;expected_direction&quot;:&quot;39% for paired associative stimulation, 45% for anodal tDCS, 43% for intermittent TBS&quot;,&quot;distribution&quot;:&quot;bimodal&quot;,&quot;cross_protocol&quot;:&quot;response to one protocol did not reliably predict response to another&quot;}</data></edge>
    <edge id="C0221" source="baseline-mep-amplitude-age-target-muscle-and-tim-0u154gt" target="theta-burst-stimulation-response-0zt9s4g"><data key="e_claim_id">C0221</data><data key="e_predicate">modulates</data><data key="e_refs">107</data><data key="e_status">contested</data><data key="e_evidence">human-observational</data><data key="e_level">cellular</data><data key="e_species">human</data><data key="e_section">v0-6-cellular-responses</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_hypothesis">H-tdcs-plasticity-p3</data><data key="e_hypothesis_group">H-tdcs-plasticity</data><data key="e_parameters">{&quot;pooling&quot;:&quot;individual data from 430 healthy participants in 22 studies&quot;,&quot;variability&quot;:&quot;large between-person variability in TBS response&quot;,&quot;itbs_predictors&quot;:&quot;lower baseline MEP amplitude, older age, target muscle, time of day&quot;,&quot;ctbs_predictors&quot;:&quot;baseline MEP and measurement timepoint&quot;,&quot;authors_attribution&quot;:&quot;much of the variability attributed to measurement method, with a call for standardisation&quot;,&quot;caveat&quot;:&quot;the predictors are real; the group effects they explain are small&quot;}</data></edge>
