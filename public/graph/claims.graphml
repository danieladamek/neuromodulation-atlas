    <edge id="C0286" source="cholinergic-noradrenergic-and-serotonergic-recep-0s1u7ot" target="vns-dependent-cortical-map-expansion-1ot0lwm"><data key="e_claim_id">C0286</data><data key="e_predicate">required_for</data><data key="e_refs">142</data><data key="e_status">supported</data><data key="e_evidence">animal-interventional</data><data key="e_level">circuit</data><data key="e_species">rat</data><data key="e_section">v0-8-circuits-networks-neuromodulators</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;drugs&quot;:&quot;oxybutynin, prazosin or duloxetine dosed daily at clinically relevant doses&quot;,&quot;pairing&quot;:&quot;VNS paired with a jaw movement&quot;,&quot;result&quot;:&quot;all groups showed the expected VNS-dependent map expansion, so blockade did not block it (negative)&quot;,&quot;inference&quot;:&quot;pharmacological blockade and lesion of the source nucleus are not interchangeable evidence for the same edge&quot;}</data></edge>
