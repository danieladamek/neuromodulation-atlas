    <edge id="C0223" source="stimulation-of-scalp-cranial-and-cervical-nerves-1agzltj" target="transcranial-direct-current-stimulation-effects-0l42a8w"><data key="e_claim_id">C0223</data><data key="e_predicate">confounds</data><data key="e_refs">109;54;55</data><data key="e_status">contested</data><data key="e_evidence">human-observational</data><data key="e_level">cellular</data><data key="e_species">human</data><data key="e_section">v0-6-cellular-responses</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_hypothesis">H-tdcs-plasticity-p2</data><data key="e_hypothesis_group">H-tdcs-plasticity</data><data key="e_parameters">{&quot;method&quot;:&quot;re-examination of six published tDCS studies&quot;,&quot;claim&quot;:&quot;scalp cranial and cervical nerve stimulation could explain the reported effects instead&quot;,&quot;precedent&quot;:&quot;for alternating current, anaesthetising the skin reduced tACS-induced tremor entrainment and peripheral nerve stimulation alone reproduced the motor effects in rats and humans&quot;,&quot;counter&quot;:&quot;macaque hippocampal and visual cortex neurons remained entrained to tACS after topical anaesthesia&quot;,&quot;decisive_design_requested&quot;:&quot;transcranial and transcutaneous routes manipulated independently in the same participants&quot;}</data></edge>
    <edge id="C0224" source="rapid-global-homeostatic-synaptic-plasticity-1yo41i9" target="antidepressant-action-of-fast-acting-agents-such-1anda0d"><data key="e_claim_id">C0224</data><data key="e_predicate">modulates</data><data key="e_refs">120;166</data><data key="e_status">supported</data><data key="e_evidence">consensus</data><data key="e_level">cellular</data><data key="e_species">n/a</data><data key="e_section">v0-6-cellular-responses</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;argument&quot;:&quot;fast-acting antidepressants act through rapid global homeostatic plasticity rather than input-specific Hebbian plasticity&quot;,&quot;founding_observation&quot;:&quot;in 18 patients with treatment-resistant depression, intravenous ketamine 0.5 mg/kg improved Hamilton scores within 110 minutes with benefit persisting about a week&quot;}</data></edge>
