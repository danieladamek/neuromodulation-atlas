    <edge id="C0504" source="looseness-of-controls-and-smallness-of-sample-0kwnzox" target="published-effect-size-in-neuromodulation-0fdullr"><data key="e_claim_id">C0504</data><data key="e_predicate">confounds</data><data key="e_refs">178;206;207</data><data key="e_status">inferred</data><data key="e_evidence">inferred</data><data key="e_level">systemic</data><data key="e_species">human</data><data key="e_section">v0-13-evidence-and-translation</data><data key="e_volume">v0</data><data key="e_synthesis">true</data><data key="e_parameters">{&quot;direction&quot;:&quot;effects shrink as controls tighten and samples grow&quot;,&quot;supports&quot;:&quot;low power inflates published effect sizes; only about 45-50% of surveyed researchers could routinely reproduce published results; unmeasured unblinding is argued to inflate drug-trial effects&quot;,&quot;caveat&quot;:&quot;no study in this corpus measures an animal-to-human effect-size ratio directly, so the direction is an inference, not a measurement&quot;}</data></edge>
