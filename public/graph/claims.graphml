    <edge id="C0296" source="direct-electrical-stimulation-of-the-peripheral-1ftjqte" target="hepatic-tnf-synthesis-and-the-serum-tnf-peak-in-0yn19f1"><data key="e_claim_id">C0296</data><data key="e_predicate">inhibits</data><data key="e_refs">148</data><data key="e_status">supported</data><data key="e_evidence">animal-interventional</data><data key="e_level">systemic</data><data key="e_species">rat</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;model&quot;:&quot;rats made endotoxaemic&quot;,&quot;effects&quot;:&quot;inhibited hepatic TNF synthesis, blunted the peak of serum TNF and prevented shock&quot;,&quot;chain&quot;:&quot;drive, coupling, cellular, molecular, system and outcome in one preparation&quot;}</data></edge>
    <edge id="C0297" source="efferent-parasympathetic-anti-inflammatory-pathw-16xnszh" target="systemic-cytokine-production-during-endotoxaemia-0tqxfiw"><data key="e_claim_id">C0297</data><data key="e_predicate">inhibits</data><data key="e_refs">148;149</data><data key="e_status">contested</data><data key="e_evidence">animal-interventional</data><data key="e_level">systemic</data><data key="e_species">rat</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_hypothesis">H-inflammatory-reflex-p1</data><data key="e_hypothesis_group">H-inflammatory-reflex</data><data key="e_parameters">{&quot;authors_reading&quot;:&quot;an efferent, parasympathetic anti-inflammatory pathway&quot;,&quot;distinction&quot;:&quot;distinct from the already-described afferent vagal route that acts through the HPA axis&quot;,&quot;formalisation&quot;:&quot;inflammatory state is sensed and regulated in real time as heart rate is, which makes cytokine concentration a controlled variable and therefore a target for a device&quot;}</data></edge>
    <edge id="C0298" source="unreported-current-frequency-pulse-width-and-tra-0pgyp7q" target="vagus-nerve-stimulation-as-a-reproducible-drive-0pp7pls"><data key="e_claim_id">C0298</data><data key="e_predicate">confounds</data><data key="e_refs">148;140</data><data key="e_status">inferred</data><data key="e_evidence">inferred</data><data key="e_level">systemic</data><data key="e_species">rat</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">true</data><data key="e_parameters">{&quot;gap&quot;:&quot;the record this volume works from does not carry the current, frequency, pulse width or train duration of that rat stimulation&quot;,&quot;consequence&quot;:&quot;the founding experiment cannot be replicated from what is cited here&quot;,&quot;later_work&quot;:&quot;the parametric work that makes a vagal drive reproducible was done later and for a different readout&quot;}</data></edge>
    <edge id="C0299" source="pulse-locked-mesencephalic-trigeminal-nucleus-co-0ogrpto" target="cervical-vagus-nerve-stimulation-as-a-selective-11fo0jp"><data key="e_claim_id">C0299</data><data key="e_predicate">confounds</data><data key="e_refs">140</data><data key="e_status">supported</data><data key="e_evidence">animal-interventional</data><data key="e_level">systemic</data><data key="e_species">rat</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;control_condition&quot;:&quot;mesencephalic trigeminal nucleus included as a control for non-specific recruitment&quot;,&quot;threshold&quot;:&quot;pulse-locked trigeminal activity appeared only above 1.2 mA&quot;,&quot;consequence&quot;:&quot;the same cuff at two amplitudes is two different drives, one of which co-recruits trigeminal afferents&quot;}</data></edge>
    <edge id="C0300" source="acetylcholine-at-alpha7-nicotinic-receptors-on-c-1opgddb" target="vagal-suppression-of-splenic-tnf-1l807va"><data key="e_claim_id">C0300</data><data key="e_predicate">required_for</data><data key="e_refs">150</data><data key="e_status">supported</data><data key="e_evidence">animal-interventional</data><data key="e_level">molecular</data><data key="e_species">mouse</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;anatomical_hole&quot;:&quot;vagal fibres do not innervate the spleen and lack the machinery to synthesise acetylcholine there&quot;,&quot;termination&quot;:&quot;the arc terminates on a receptor expressed by a macrophage&quot;}</data></edge>
    <edge id="C0301" source="splenic-memory-phenotype-choline-acetyltransfera-0i1jgun" target="inhibition-of-tnf-by-vagus-nerve-stimulation-0awdl73"><data key="e_claim_id">C0301</data><data key="e_predicate">required_for</data><data key="e_refs">150</data><data key="e_status">contested</data><data key="e_evidence">animal-interventional</data><data key="e_level">systemic</data><data key="e_species">mouse</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_hypothesis">H-inflammatory-reflex-p1</data><data key="e_hypothesis_group">H-inflammatory-reflex</data><data key="e_parameters">{&quot;identification&quot;:&quot;a memory-phenotype ChAT-expressing T cell population in the spleen&quot;,&quot;role&quot;:&quot;the efferent arc passes through a lymphocyte that makes the transmitter&quot;}</data></edge>
    <edge id="C0302" source="non-neuronal-cells-as-chain-nodes-1sjh162" target="a-schema-able-to-represent-drive-to-outcome-chai-1g5vp3d"><data key="e_claim_id">C0302</data><data key="e_predicate">required_for</data><data key="e_refs">150;158</data><data key="e_status">inferred</data><data key="e_evidence">inferred</data><data key="e_level">systemic</data><data key="e_species">mouse</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">true</data><data key="e_parameters">{&quot;case_one&quot;:&quot;an acetylcholine-producing splenic T lymphocyte in the efferent vagal arc&quot;,&quot;case_two&quot;:&quot;enteroendocrine neuropod cells in gut interoception&quot;,&quot;consequence&quot;:&quot;the schema cannot restrict nodes to neurons, axons and brain regions&quot;}</data></edge>
    <edge id="C0303" source="noradrenergic-nerve-terminals-in-the-spleen-0ct8hjy" target="suppression-of-systemic-tnf-by-vagal-stimulation-19no7xh"><data key="e_claim_id">C0303</data><data key="e_predicate">required_for</data><data key="e_refs">151</data><data key="e_status">supported</data><data key="e_evidence">consensus</data><data key="e_level">systemic</data><data key="e_species">rat</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;audited_and_accepted&quot;:&quot;stimulating the cut peripheral end of either vagus suppresses local and systemic inflammation; the spleen is where systemic TNF is produced and suppressed; the effect requires splenic noradrenergic terminals and ChAT-positive T lymphocytes; alpha7 nicotinic receptors are essential&quot;}</data></edge>
    <edge id="C0304" source="vagal-stimulation-1dup16g" target="action-potentials-in-the-splenic-nerve-12jvwm2"><data key="e_claim_id">C0304</data><data key="e_predicate">activates</data><data key="e_refs">151</data><data key="e_status">contested</data><data key="e_evidence">animal-interventional</data><data key="e_level">systemic</data><data key="e_species">rat</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_hypothesis">H-inflammatory-reflex-p2</data><data key="e_hypothesis_group">H-inflammatory-reflex</data><data key="e_parameters">{&quot;result&quot;:&quot;vagal stimulation does not drive action potentials in the splenic nerve (negative)&quot;,&quot;rejected_claim&quot;:&quot;the proposed disynaptic connection from vagus to splenic nerve&quot;,&quot;conclusion&quot;:&quot;the pathway is activatable, electrically and pharmacologically, but it is not the efferent arm of a physiological reflex to endotoxaemia&quot;,&quot;settling_experiment&quot;:&quot;recordings showing splenic nerve traffic driven by vagal stimulation, and changing when an animal is made inflamed with the vagus intact; the first has been attempted and reported negative&quot;}</data></edge>
    <edge id="C0305" source="heart-rate-variability-indices-of-vagal-activity-0bq0rah" target="circulating-cytokine-concentrations-in-humans-0y2wpop"><data key="e_claim_id">C0305</data><data key="e_predicate">correlates_with</data><data key="e_refs">152</data><data key="e_status">supported</data><data key="e_evidence">human-observational</data><data key="e_level">systemic</data><data key="e_species">human</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;body_of_work&quot;:&quot;a large correlational literature of HRV-cytokine associations against a much smaller set of experimental studies&quot;,&quot;limits&quot;:&quot;weak causal designs, inconsistent measures of vagal activity and limited target-engagement evidence&quot;}</data></edge>
    <edge id="C0306" source="implanted-vagus-nerve-neuroimmune-modulation-dev-1vju2ux" target="acr20-response-in-rheumatoid-arthritis-1yomc9j"><data key="e_claim_id">C0306</data><data key="e_predicate">increases</data><data key="e_refs">153</data><data key="e_status">supported</data><data key="e_evidence">human-interventional</data><data key="e_level">clinical</data><data key="e_species">human</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;trial&quot;:&quot;RESET-RA, randomised active versus sham&quot;,&quot;n&quot;:&quot;242 patients with rheumatoid arthritis refractory to or intolerant of biologic or targeted synthetic DMARDs&quot;,&quot;blinded_phase&quot;:&quot;three months, then open-label stimulation to twelve months&quot;,&quot;primary_result&quot;:&quot;ACR20 at three months 35.2% active versus 24.2% sham, p = 0.02&quot;,&quot;completers&quot;:&quot;50.0% at six months and 52.8% at twelve months&quot;,&quot;safety&quot;:&quot;adverse events similar between arms; the few related serious events were perioperative and resolved&quot;}</data></edge>
    <edge id="C0307" source="an-eleven-point-sham-controlled-responder-rate-d-0m0eal4" target="adjudication-between-the-reflex-and-activatable-1dto8al"><data key="e_claim_id">C0307</data><data key="e_predicate">confounds</data><data key="e_refs">151;153</data><data key="e_status">inferred</data><data key="e_evidence">inferred</data><data key="e_level">clinical</data><data key="e_species">human</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">true</data><data key="e_parameters">{&quot;reading&quot;:&quot;a real result and a modest one in a refractory population&quot;,&quot;limit&quot;:&quot;a benefit of this size is compatible with both the reflex account and the activatable-but-not-reflex account&quot;,&quot;what_would_settle_it&quot;:&quot;electrophysiology rather than outcome data&quot;}</data></edge>
    <edge id="C0308" source="continuous-cymba-conchae-transcutaneous-auricula-0rsmh36" target="event-related-pupil-dilation-resting-pupil-size-1kwdixd"><data key="e_claim_id">C0308</data><data key="e_predicate">modulates</data><data key="e_refs">145</data><data key="e_status">contested</data><data key="e_evidence">human-interventional</data><data key="e_level">systemic</data><data key="e_species">human</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_hypothesis">H-tavns-engagement-p1</data><data key="e_hypothesis_group">H-tavns-engagement</data><data key="e_parameters">{&quot;n&quot;:&quot;66 healthy participants&quot;,&quot;comparator&quot;:&quot;earlobe sham&quot;,&quot;intensity&quot;:&quot;individually titrated just below pain threshold&quot;,&quot;result&quot;:&quot;no effect on any of the measured indices (negative)&quot;,&quot;positive_control&quot;:&quot;the task itself produced the expected pupil effects&quot;}</data></edge>
    <edge id="C0309" source="pulsed-versus-continuous-tavns-waveform-0xg4f6v" target="pupil-dilation-as-an-index-of-target-engagement-143gxm5"><data key="e_claim_id">C0309</data><data key="e_predicate">modulates</data><data key="e_refs">146;138</data><data key="e_status">contested</data><data key="e_evidence">human-interventional</data><data key="e_level">systemic</data><data key="e_species">human</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_hypothesis">H-tavns-engagement-p2</data><data key="e_hypothesis_group">H-tavns-engagement</data><data key="e_parameters">{&quot;pooling&quot;:&quot;living Bayesian meta-analysis of 18 taVNS studies, N = 771&quot;,&quot;overall&quot;:&quot;anecdotal evidence only, g = 0.15, BF01 = 1.0&quot;,&quot;pulsed&quot;:&quot;strong evidence for an effect, g = 0.36, BF10 = 50.8&quot;,&quot;continuous&quot;:&quot;strong evidence for the null, g = 0.002, BF01 = 21.9&quot;,&quot;mapping&quot;:&quot;the split maps onto the phasic and tonic locus coeruleus regimes of the adaptive-gain account&quot;,&quot;inference&quot;:&quot;waveform, not intensity, is the decisive parameter&quot;}</data></edge>
    <edge id="C0310" source="fibre-class-heterogeneity-of-the-vagus-0tqrulm" target="vagal-stimulation-as-engagement-of-a-single-chan-0jic9o2"><data key="e_claim_id">C0310</data><data key="e_predicate">confounds</data><data key="e_refs">157</data><data key="e_status">supported</data><data key="e_evidence">consensus</data><data key="e_level">systemic</data><data key="e_species">rodent</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;organisation&quot;:&quot;vagal sensory neurons organised by molecularly defined cell type across respiratory, cardiovascular and digestive systems&quot;,&quot;gap&quot;:&quot;little is established about signal transduction in vagal afferents and their upstream sentinel cells compared with the external senses&quot;,&quot;consequence&quot;:&quot;a cuff or an ear electrode engages a mixture of labelled lines rather than a channel&quot;}</data></edge>
    <edge id="C0311" source="enteroendocrine-neuropod-cells-0adwobi" target="vagal-afferent-neurons-through-a-glutamatergic-s-1jmcnq3"><data key="e_claim_id">C0311</data><data key="e_predicate">projects_to</data><data key="e_refs">158</data><data key="e_status">supported</data><data key="e_evidence">animal-interventional</data><data key="e_level">systemic</data><data key="e_species">mouse</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;prior_assumption&quot;:&quot;gut-brain signalling assumed hormonal and therefore slow, because no synapse was known between intestinal epithelium and vagus&quot;,&quot;finding&quot;:&quot;enteroendocrine cells form glutamatergic synapses with vagal afferents and transduce luminal stimuli in milliseconds&quot;,&quot;architecture&quot;:&quot;lumen to brainstem across a single synapse&quot;}</data></edge>
    <edge id="C0312" source="prefrontal-tms-or-tdcs-10ijdge" target="acute-cortisol-response-to-a-laboratory-stressor-0qbaxdf"><data key="e_claim_id">C0312</data><data key="e_predicate">decreases</data><data key="e_refs">159</data><data key="e_status">supported</data><data key="e_evidence">human-interventional</data><data key="e_level">systemic</data><data key="e_species">human</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;pooling&quot;:&quot;meta-analysis of 16 randomised controlled trials in healthy adults&quot;,&quot;effect_size&quot;:&quot;SMD = -0.72&quot;,&quot;moderators&quot;:&quot;larger effects for TMS than tDCS, and for stimulation delivered before or after rather than during the stressor&quot;,&quot;inference&quot;:&quot;timing relative to the challenge is part of the dose&quot;}</data></edge>
    <edge id="C0313" source="pregnane-steroids-acting-as-circulating-endocrin-1xxkklq" target="gaba-a-receptor-function-by-a-direct-non-genomic-1s53kef"><data key="e_claim_id">C0313</data><data key="e_predicate">modulates</data><data key="e_refs">179</data><data key="e_status">supported</data><data key="e_evidence">consensus</data><data key="e_level">molecular</data><data key="e_species">n/a</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;dual_role&quot;:&quot;one molecule can be a systemic drive or a local one&quot;,&quot;mechanism&quot;:&quot;positive modulation of GABA-A receptor function rather than a genomic action&quot;}</data></edge>
    <edge id="C0314" source="sckan-the-sparc-connectivity-knowledge-base-of-t-0412tr3" target="curated-population-level-structural-connectivity-0v18usz"><data key="e_claim_id">C0314</data><data key="e_predicate">measured_by</data><data key="e_refs">155</data><data key="e_status">supported</data><data key="e_evidence">consensus</data><data key="e_level">systemic</data><data key="e_species">n/a</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;content&quot;:&quot;origins, terminations and routing of autonomic projections between the central nervous system and end organs&quot;,&quot;provenance&quot;:&quot;expert input, published literature, textbooks and SPARC datasets&quot;,&quot;use&quot;:&quot;generates the connectivity maps on the SPARC portal&quot;,&quot;what_it_is_not&quot;:&quot;not a source of stimulation-response or physiological measurement data; nothing in it says what a 0.1 mA half-second train does to locus coeruleus firing, whether vagal stimulation drives splenic nerve spikes, or how large an ACR20 difference an implant produces&quot;}</data></edge>
    <edge id="C0315" source="compositional-phenotype-naming-with-community-on-13ae81i" target="comparable-neuron-population-nodes-in-an-autonom-1nt8or1"><data key="e_claim_id">C0315</data><data key="e_predicate">required_for</data><data key="e_refs">156</data><data key="e_status">supported</data><data key="e_evidence">consensus</data><data key="e_level">systemic</data><data key="e_species">n/a</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;method&quot;:&quot;decomposes a neuron type into phenotypes carrying identifiers from community ontologies rather than an opaque label&quot;,&quot;demonstration&quot;:&quot;reconciled three published cortical neuron classifications with each other and with informal literature names&quot;}</data></edge>
    <edge id="C0316" source="species-neutral-anatomy-ontology-linking-species-0t05v8o" target="comparison-of-an-organ-or-structure-across-human-10q3toz"><data key="e_claim_id">C0316</data><data key="e_predicate">required_for</data><data key="e_refs">214</data><data key="e_status">supported</data><data key="e_evidence">consensus</data><data key="e_level">systemic</data><data key="e_species">n/a</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;role&quot;:&quot;organ and structure identifiers for the autonomic connectivity resource&quot;}</data></edge>
    <edge id="C0317" source="route-direction-afferent-versus-efferent-carried-0akblvt" target="a-vagal-chain-edge-that-preserves-its-claim-1vrb4i5"><data key="e_claim_id">C0317</data><data key="e_predicate">required_for</data><data key="e_refs">148;157;150;140</data><data key="e_status">inferred</data><data key="e_evidence">inferred</data><data key="e_level">systemic</data><data key="e_species">n/a</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">true</data><data key="e_parameters">{&quot;direction&quot;:&quot;afferent and efferent vagal routes have different anatomy, different transducers and different consequences, and the founding paper distinguishes its efferent pathway from an afferent HPA route in the same nerve&quot;,&quot;sign&quot;:&quot;vagal stimulation suppresses TNF through one branch and raises locus coeruleus firing through another, so the drive carries no sign of its own&quot;,&quot;edge_that_loses_the_claim&quot;:&quot;vagus to spleen&quot;}</data></edge>
    <edge id="C0318" source="evidence-type-recorded-on-every-imported-edge-0mrs0s3" target="importing-curated-anatomy-alongside-stimulation-1k9tww0"><data key="e_claim_id">C0318</data><data key="e_predicate">required_for</data><data key="e_refs">148;150;151;152;153;155;214;218</data><data key="e_status">inferred</data><data key="e_evidence">inferred</data><data key="e_level">systemic</data><data key="e_species">n/a</data><data key="e_section">v0-9-body-systems</data><data key="e_volume">v0</data><data key="e_synthesis">true</data><data key="e_parameters">{&quot;species_spread&quot;:&quot;the molecular chain is rodent with human in vitro pharmacology, the critique is rodent electrophysiology, the clinical result is human, the human mechanism literature is largely correlational, and the anatomy resource is multi-species by construction&quot;,&quot;failure_mode&quot;:&quot;reading a curated anatomical projection and a sham-controlled trial as the same kind of fact&quot;}</data></edge>
    <edge id="C0330" source="electrode-placement-and-pulse-width-in-electroco-1v59d0y" target="remission-rate-in-depression-1667rc9"><data key="e_claim_id">C0330</data><data key="e_predicate">modulates</data><data key="e_refs">260;261;263</data><data key="e_status">supported</data><data key="e_evidence">human-interventional</data><data key="e_level">clinical</data><data key="e_species">human</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;design&quot;:&quot;2 x 2 randomised trial&quot;,&quot;n&quot;:&quot;90 patients&quot;,&quot;ultrabrief_right_unilateral&quot;:&quot;73% remission at 0.3 ms&quot;,&quot;ultrabrief_bilateral&quot;:&quot;35% remission&quot;,&quot;inference&quot;:&quot;efficacy does not follow delivered charge, and total charge and energy are argued to be the wrong abstraction&quot;,&quot;open_question&quot;:&quot;whether the antidepressant action comes from the seizure, from the electricity, or from their interaction&quot;}</data></edge>
    <edge id="C0331" source="magnetic-seizure-therapy-0vht4ha" target="a-generalised-seizure-from-a-field-confined-larg-18dc0eg"><data key="e_claim_id">C0331</data><data key="e_predicate">activates</data><data key="e_refs">227;225</data><data key="e_status">supported</data><data key="e_evidence">human-interventional</data><data key="e_level">clinical</data><data key="e_species">human</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;trial&quot;:&quot;double-blind randomised trial at three hospitals&quot;,&quot;n&quot;:&quot;73 adults&quot;,&quot;response&quot;:&quot;51.4% for MST against 42.1% for ultrabrief right unilateral ECT, sustained at six months&quot;,&quot;cognition&quot;:&quot;significantly longer time to reorientation and fewer cognitive adverse effects than ECT&quot;,&quot;field&quot;:&quot;finite-element simulation puts the suprathreshold volume well inside that of four ECT montages&quot;,&quot;argument&quot;:&quot;comparable efficacy from a much more focal field is the strongest available argument for the seizure rather than the field&quot;,&quot;limit&quot;:&quot;no trial beyond the single blinded head-to-head&quot;}</data></edge>
    <edge id="C0332" source="epidural-cortical-stimulation-0o47uxo" target="corticospinal-neurons-trans-synaptically-read-as-19ic1f5"><data key="e_claim_id">C0332</data><data key="e_predicate">activates</data><data key="e_refs">58</data><data key="e_status">supported</data><data key="e_evidence">human-interventional</data><data key="e_level">circuit</data><data key="e_species">human</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;measurement&quot;:&quot;human epidural recordings of descending corticospinal volleys during transcranial stimulation&quot;,&quot;dependence&quot;:&quot;recruitment depends on current direction&quot;,&quot;resolution&quot;:&quot;millisecond ordering of direct and indirect volleys, with no spatial figure&quot;,&quot;corpus_gap&quot;:&quot;the corpus's epidural material is recordings rather than therapeutic drive&quot;}</data></edge>
    <edge id="C0333" source="amplitude-and-frequency-at-a-single-intracortica-0vjvacn" target="modality-of-the-evoked-percept-cutaneous-or-prop-0yk2trn"><data key="e_claim_id">C0333</data><data key="e_predicate">modulates</data><data key="e_refs">249</data><data key="e_status">supported</data><data key="e_evidence">human-interventional</data><data key="e_level">clinical</data><data key="e_species">human</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;finding&quot;:&quot;at one electrode, amplitude and frequency decide whether the percept is cutaneous or proprioceptive, and some electrodes are multimodal&quot;,&quot;consequence&quot;:&quot;an electrode is not a labelled line&quot;,&quot;design_limit&quot;:&quot;single-participant designs throughout&quot;}</data></edge>
    <edge id="C0334" source="intracortical-microstimulation-used-as-a-write-i-0h3e9zy" target="contact-location-and-pressure-information-availa-1a8q0df"><data key="e_claim_id">C0334</data><data key="e_predicate">increases</data><data key="e_refs">248;250</data><data key="e_status">supported</data><data key="e_evidence">human-interventional</data><data key="e_level">clinical</data><data key="e_species">human</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;coupling&quot;:&quot;direct cortical excitation writing tactile information into somatosensory cortex&quot;,&quot;stability&quot;:&quot;percepts stable over months, with stimulation performance holding over 1,500 days&quot;,&quot;thresholds&quot;:&quot;median detection threshold 31.5 microA at day 100 falling to 10.4 microA at day 1500&quot;,&quot;missing&quot;:&quot;performance of a full decode-and-write-in loop as a system, and any multi-participant series&quot;}</data></edge>
    <edge id="C0335" source="respiration-gated-hypoglossal-nerve-stimulation-0wbd9yw" target="apnoea-hypopnoea-index-in-obstructive-sleep-apno-0ukgd19"><data key="e_claim_id">C0335</data><data key="e_predicate">decreases</data><data key="e_refs">252;254</data><data key="e_status">supported</data><data key="e_evidence">human-interventional</data><data key="e_level">clinical</data><data key="e_species">human</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;coupling&quot;:&quot;excitation of a somatic motor nerve producing timed tongue-protrusor contraction, with a mechanical endpoint rather than a modulated state&quot;,&quot;n&quot;:&quot;126 CPAP-intolerant patients&quot;,&quot;result&quot;:&quot;median apnoea-hypopnoea index down 68%, from 29.3 to 9.0 events/hour at 12 months&quot;,&quot;causal_control&quot;:&quot;a randomised therapy-withdrawal substudy confirmed device dependence&quot;,&quot;pooled&quot;:&quot;30 studies, index down 20.11 events/hour (95% CI 23.13 to 17.10) at one year&quot;,&quot;limit&quot;:&quot;only 4 of the 30 pooled studies were randomised&quot;}</data></edge>
    <edge id="C0336" source="occipital-nerve-stimulation-02w6nl5" target="weekly-attack-frequency-in-medically-intractable-0syffrh"><data key="e_claim_id">C0336</data><data key="e_predicate">decreases</data><data key="e_refs">255</data><data key="e_status">supported</data><data key="e_evidence">human-interventional</data><data key="e_level">clinical</data><data key="e_species">human</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;design&quot;:&quot;randomised, double-blind, multicentre phase 3 dose-controlled trial&quot;,&quot;dose_arms&quot;:&quot;intensity set at 100% or 30% of the individually determined paraesthesia-to-near-discomfort range rather than in mA&quot;,&quot;result&quot;:&quot;median weekly attack frequency fell substantially by weeks 21-24 (p &lt; 0.0001), similarly in both arms&quot;,&quot;consequence&quot;:&quot;a dose-dependent therapeutic effect cannot be separated from a non-specific one&quot;,&quot;missing&quot;:&quot;a sham comparison, which an unmistakable paraesthesia makes impossible, and with it the mechanism of benefit&quot;}</data></edge>
    <edge id="C0337" source="epidural-spinal-cord-stimulation-1gf10bq" target="large-myelinated-dorsal-root-afferents-which-eng-1k7erey"><data key="e_claim_id">C0337</data><data key="e_predicate">activates</data><data key="e_refs">61</data><data key="e_status">supported</data><data key="e_evidence">computational</data><data key="e_level">circuit</data><data key="e_species">rat</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;claim&quot;:&quot;recruitment of large myelinated dorsal-root afferents rather than motoneurons or interneurons directly&quot;,&quot;validation&quot;:&quot;modelled and confirmed in rats for intensity and electrode position&quot;,&quot;corpus_gap&quot;:&quot;no human mechanism source; one computational model with rat validation and one expert taxonomy&quot;}</data></edge>
    <edge id="C0338" source="surface-or-implanted-peripheral-motor-nerve-stim-0ot5og0" target="motor-units-non-selectively-spatially-fixed-and-1s2oy28"><data key="e_claim_id">C0338</data><data key="e_predicate">activates</data><data key="e_refs">246</data><data key="e_status">supported</data><data key="e_evidence">consensus</data><data key="e_level">systemic</data><data key="e_species">human</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;rejected_textbook_claim&quot;:&quot;the strict reverse (large-to-small) recruitment order is not supported&quot;,&quot;consequence&quot;:&quot;synchronous firing of the same units is the source of the rapid fatigue, and the stimulated population does not rotate as in voluntary contraction&quot;,&quot;missing&quot;:&quot;a selective recruitment method that reproduces the size principle, and fatigue-resistant parameter sets&quot;}</data></edge>
    <edge id="C0339" source="transcranial-pulse-stimulation-1j7r0no" target="cerad-corrected-total-score-in-alzheimer-s-disea-0fr66dt"><data key="e_claim_id">C0339</data><data key="e_predicate">modulates</data><data key="e_refs">229;228</data><data key="e_status">supported</data><data key="e_evidence">human-interventional</data><data key="e_level">clinical</data><data key="e_species">human</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_finding">null-result</data><data key="e_finding_note">primary endpoint not met (benefit only in the pre-specified younger subgroup)</data><data key="e_parameters">{&quot;design&quot;:&quot;double-blind sham-controlled crossover trial with successful blinding&quot;,&quot;n&quot;:&quot;60 patients on standard therapy&quot;,&quot;dose&quot;:&quot;6,000 pulses at 0.20 mJ/mm2 and 5 Hz, about 3 microseconds per pulse&quot;,&quot;missed_primary_endpoint&quot;:&quot;CERAD corrected total score rose 2.22 points after verum against 1.00 after sham at three months, with a non-significant condition-by-session interaction, P = .68&quot;,&quot;subgroup&quot;:&quot;benefit confined to a prespecified subgroup aged 70 or under&quot;,&quot;superseded_result&quot;:&quot;a 35-patient open-label series had reported three-month improvement correlated with memory-network connectivity&quot;,&quot;missing&quot;:&quot;a confirmed clinical effect and an established coupling mechanism&quot;}</data></edge>
    <edge id="C0340" source="organ-directed-focused-ultrasound-aimed-at-a-sub-1vamocm" target="ex-vivo-tnf-production-in-healthy-human-voluntee-0u5u5hr"><data key="e_claim_id">C0340</data><data key="e_predicate">decreases</data><data key="e_refs">259;256</data><data key="e_status">supported</data><data key="e_evidence">human-interventional</data><data key="e_level">systemic</data><data key="e_species">human</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;protocol&quot;:&quot;three minutes delivered in intermittent 15 s intervals, either swept continuously at 11.7 mW/cm2 or focused-pulsed at 174.8-225.4 mW/cm2&quot;,&quot;result&quot;:&quot;ex vivo TNF production fell for more than two hours and returned to baseline by 24 h, with no adverse clinical or laboratory effects&quot;,&quot;rival_reading&quot;:&quot;the effect did not differ by stimulation mode or across a roughly fifteen-fold intensity difference, which is hard to reconcile with a dose-dependent mechanical-neural mechanism and is compatible with a local tissue effect rather than a neural reflex&quot;,&quot;missing&quot;:&quot;any human measurement of the neurotransmitter relay and any energy-response relationship&quot;}</data></edge>
    <edge id="C0341" source="40-hz-audio-visual-sensory-entrainment-delivered-0dc0v1b" target="primary-cognitive-composite-in-mild-to-moderate-0zw80qu"><data key="e_claim_id">C0341</data><data key="e_predicate">modulates</data><data key="e_refs">234;233</data><data key="e_status">supported</data><data key="e_evidence">human-interventional</data><data key="e_level">clinical</data><data key="e_species">human</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_finding">null-result</data><data key="e_finding_note">primary cognitive composite not met</data><data key="e_parameters">{&quot;design&quot;:&quot;six-month sham-controlled trial randomised 2:1, EEG-verified delivery, adherence 85-90%, no serious treatment-related adverse events&quot;,&quot;n&quot;:&quot;70 analysable patients&quot;,&quot;missed_primary_endpoint&quot;:&quot;the primary cognitive composite was missed&quot;,&quot;unadjusted_secondaries&quot;:&quot;nominally favourable — MMSE decline reduced 76%, ADCS-ADL decline 77%, whole-brain volume loss 69%&quot;,&quot;superseded_result&quot;:&quot;pilot work in 15 patients had reported less ventricular dilation and hippocampal atrophy&quot;,&quot;missing&quot;:&quot;a positive primary endpoint and multiplicity-adjusted secondary outcomes&quot;}</data></edge>
    <edge id="C0342" source="shifted-and-summed-rate-matched-transient-evoked-0yqdwfl" target="steady-state-response-to-rhythmic-sensory-stimul-082cpz1"><data key="e_claim_id">C0342</data><data key="e_predicate">modulates</data><data key="e_refs">232;231</data><data key="e_status">supported</data><data key="e_evidence">human-interventional</data><data key="e_level">circuit</data><data key="e_species">human</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;claim&quot;:&quot;linear superposition rather than entrainment, with no signature of oscillatory entrainment at the stimulation frequency&quot;,&quot;rival&quot;:&quot;the resonance reading of the human flicker frequency-response curve, which peaks near 10, 20, 40 and 80 Hz across 1-100 Hz&quot;,&quot;open_question&quot;:&quot;whether the driven response involves an entrained oscillator at all&quot;}</data></edge>
    <edge id="C0343" source="galvanic-vestibular-stimulation-0yhotqn" target="spike-initiation-zone-of-vestibular-primary-affe-0rp0fo6"><data key="e_claim_id">C0343</data><data key="e_predicate">polarizes</data><data key="e_refs">235;237</data><data key="e_status">supported</data><data key="e_evidence">consensus</data><data key="e_level">biophysical</data><data key="e_species">human</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;locus&quot;:&quot;DC bias of firing at the spike-initiation zone rather than at the hair cell or the central nuclei&quot;,&quot;sensitivity&quot;:&quot;irregular afferents most sensitive&quot;,&quot;forward_model&quot;:&quot;the vector of biased signals converging in the vestibular nuclei predicts the direction and size of body sway across montages&quot;,&quot;dose_axes&quot;:&quot;current amplitude 0.1-4 mA, session duration 12 s to 24 h, direct, sinusoidal or stochastic waveforms, extracted from 53 clinical trials&quot;,&quot;missing&quot;:&quot;parameter consensus across indications and pooled efficacy estimates by indication&quot;}</data></edge>
    <edge id="C0344" source="transcranial-static-magnetic-field-stimulation-0jrukv5" target="motor-evoked-potential-amplitude-00eayux"><data key="e_claim_id">C0344</data><data key="e_predicate">modulates</data><data key="e_refs">240;238;241</data><data key="e_status">supported</data><data key="e_evidence">human-interventional</data><data key="e_level">cellular</data><data key="e_species">human</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_finding">null-result</data><data key="e_finding_note">non-replication at matched magnet geometry</data><data key="e_parameters">{&quot;non_replication&quot;:&quot;ten minutes at matched magnet geometry produced no MEP modulation in 18 subjects, with or without a concurrent attentional task (negative)&quot;,&quot;original_effect&quot;:&quot;MEP amplitude reduced by up to about 25% after ten minutes in single-session excitability studies&quot;,&quot;flux_density&quot;:&quot;about 160-170 mT at 2 cm from the scalp for a 45 x 30 mm N45 magnet&quot;,&quot;missing&quot;:&quot;any transduction mechanism, since no accepted pathway exists for a static field, and a pooled effect-size estimate&quot;}</data></edge>
    <edge id="C0345" source="species-gap-in-deliverable-cortical-cooling-1kp880n" target="cortical-cooling-as-a-human-therapeutic-drive-03dijsy"><data key="e_claim_id">C0345</data><data key="e_predicate">confounds</data><data key="e_refs">242;243</data><data key="e_status">inferred</data><data key="e_evidence">inferred</data><data key="e_level">biophysical</data><data key="e_species">human</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">true</data><data key="e_parameters">{&quot;preclinical_thresholds&quot;:&quot;about 20 degrees C terminates paroxysmal activity in vitro and below 24 degrees C aborts seizures within seconds in vivo&quot;,&quot;human_achieved&quot;:&quot;intraoperative surface cooling of human cortex achieved only about 0.6-2 degrees C at 10-15 mm depth&quot;,&quot;coupling&quot;:&quot;temperature dependence of channel kinetics and synaptic release slows every temperature-dependent conductance and release step at once&quot;,&quot;missing&quot;:&quot;any human therapeutic series&quot;}</data></edge>
    <edge id="C0346" source="continuous-intrathecal-baclofen-infusion-19wec0z" target="muscle-tone-and-spasm-frequency-in-severe-spasti-19n3act"><data key="e_claim_id">C0346</data><data key="e_predicate">decreases</data><data key="e_refs">163</data><data key="e_status">supported</data><data key="e_evidence">human-interventional</data><data key="e_level">clinical</data><data key="e_species">human</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;design&quot;:&quot;randomised double-blind crossover trial&quot;,&quot;n&quot;:&quot;20 patients who had failed the oral route&quot;,&quot;result&quot;:&quot;tone fell in all 20 patients and spasms were reduced in 18 of 19, maintained over a mean 19.2 months&quot;,&quot;coupling&quot;:&quot;receptor occupancy placed at the spinal cord rather than the brain, GABA-B agonism where the circuit is and not where the side effects are&quot;,&quot;missing&quot;:&quot;target-site concentration measurement&quot;}</data></edge>
    <edge id="C0347" source="convection-enhanced-intraparenchymal-delivery-1vjattb" target="volume-of-distribution-of-an-infused-molecule-in-15m6ws5"><data key="e_claim_id">C0347</data><data key="e_predicate">increases</data><data key="e_refs">160</data><data key="e_status">supported</data><data key="e_evidence">animal-interventional</data><data key="e_level">subcellular</data><data key="e_species">rat</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;coupling&quot;:&quot;a sustained pressure gradient driving bulk flow, so distribution is set by infusion physics rather than by molecular diffusivity&quot;,&quot;ratios&quot;:&quot;distribution-to-infusion volume about 6:1 for 111In-transferrin and about 13:1 for 14C-sucrose&quot;,&quot;concentration&quot;:&quot;local concentrations orders of magnitude above achievable systemic levels&quot;,&quot;spread&quot;:&quot;centimetres rather than millimetres, with the large molecule more uniformly distributed at 24 h&quot;,&quot;corpus_gap&quot;:&quot;no human outcome data in this corpus&quot;}</data></edge>
    <edge id="C0348" source="inhaled-nitrous-oxide-0w46ovu" target="depression-severity-relative-to-placebo-0dmmu81"><data key="e_claim_id">C0348</data><data key="e_predicate">decreases</data><data key="e_refs">185</data><data key="e_status">supported</data><data key="e_evidence">human-interventional</data><data key="e_level">clinical</data><data key="e_species">human</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;design&quot;:&quot;phase 2 crossover trial&quot;,&quot;n&quot;:&quot;24 patients&quot;,&quot;dose&quot;:&quot;one-hour inhalations at 25% or 50%&quot;,&quot;efficacy&quot;:&quot;improvement versus placebo, P = 0.01, with no difference between concentrations, P = 0.58&quot;,&quot;safety&quot;:&quot;adverse events far fewer at 25%, P &lt; 0.001&quot;,&quot;timing&quot;:&quot;separation from placebo emerged at weeks 1 and 2 rather than at 2 or 24 hours, so the outcome outlasts exposure by weeks&quot;,&quot;missing&quot;:&quot;a dose-response for efficacy, which saturated while side effects remained dose-dependent&quot;}</data></edge>
    <edge id="C0349" source="absence-of-any-cross-modality-comparative-source-0x0yalm" target="side-by-side-comparison-of-human-applicable-neur-003u2oe"><data key="e_claim_id">C0349</data><data key="e_predicate">confounds</data><data key="e_refs">30;31</data><data key="e_status">inferred</data><data key="e_evidence">inferred</data><data key="e_level">clinical</data><data key="e_species">n/a</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">true</data><data key="e_parameters">{&quot;families&quot;:&quot;magnetic seizure therapy, epidural cortical stimulation as a therapy, intracortical microstimulation, tRNS, transcranial pulse stimulation, peripheral or organ-directed ultrasound, sensory entrainment, galvanic vestibular stimulation, transcranial static magnetic field stimulation, cortical cooling, and brain-computer interfaces with write-in stimulation&quot;,&quot;consequence&quot;:&quot;each row was assembled from that family's own sources rather than lifted from a review that had already placed it on shared axes&quot;,&quot;gap_pattern&quot;:&quot;of 33 placeholder cells, 15 are in the named-rival column and 5 in proposed primary coupling mechanism, while the evidence-base column has none&quot;}</data></edge>
    <edge id="C0350" source="invasiveness-of-a-modality-0e8mmoc" target="how-well-its-coupling-step-is-specified-0t6ikdw"><data key="e_claim_id">C0350</data><data key="e_predicate">correlates_with</data><data key="e_refs">33;34;26;27</data><data key="e_status">inferred</data><data key="e_evidence">inferred</data><data key="e_level">biophysical</data><data key="e_species">n/a</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">true</data><data key="e_parameters">{&quot;result&quot;:&quot;no correspondence: the two best-specified coupling accounts sit at opposite ends of the invasiveness range&quot;,&quot;best_specified&quot;:&quot;an implanted electrode's activating function, where the driving term is the second spatial derivative of extracellular potential along a fibre, and a drug's receptor occupancy window measured in humans by PET&quot;,&quot;least_specified&quot;:&quot;the middle of the range, including low-intensity ultrasound with at least four candidate transducers and temporal interference with a modelled threshold two orders of magnitude above what is reachable&quot;}</data></edge>
    <edge id="C0351" source="a-safety-problem-rather-than-a-mechanism-1lnb1tk" target="every-transferable-dose-unit-in-the-modality-map-04kecs7"><data key="e_claim_id">C0351</data><data key="e_predicate">confounds</data><data key="e_refs">85;16;17;19;260;261</data><data key="e_status">inferred</data><data key="e_evidence">inferred</data><data key="e_level">clinical</data><data key="e_species">n/a</data><data key="e_section">v0-10-modality-map</data><data key="e_volume">v0</data><data key="e_synthesis">true</data><data key="e_parameters">{&quot;units&quot;:&quot;equivalent minutes at 43 degrees C for thermal exposure, charge density with charge per phase for implanted electrodes, and the mechanical index for ultrasound&quot;,&quot;exception_that_shows_the_rule&quot;:&quot;the convulsive families, whose inherited units of charge, energy and multiples of seizure threshold are argued to be the wrong abstraction because placement and pulse width change outcome at constant charge&quot;}</data></edge>
