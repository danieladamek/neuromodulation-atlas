    <edge id="C0289" source="named-biomarker-and-named-perturbation-method-on-0qhib57" target="a-circuit-level-neuromodulator-necessity-claim-0611kjt"><data key="e_claim_id">C0289</data><data key="e_predicate">required_for</data><data key="e_refs">141;142;174;137;213;135;136;144</data><data key="e_status">inferred</data><data key="e_evidence">inferred</data><data key="e_level">circuit</data><data key="e_species">n/a</data><data key="e_section">v0-8-circuits-networks-neuromodulators</data><data key="e_volume">v0</data><data key="e_synthesis">true</data><data key="e_parameters">{&quot;necessity&quot;:&quot;source-nucleus lesion and receptor antagonism give opposite answers for the same VNS plasticity effect&quot;,&quot;drug_case&quot;:&quot;for a drug the responding cell may not express the receptor&quot;,&quot;biomarker&quot;:&quot;the same protocol potentiates a corticospinal readout while leaving an EEG readout unchanged, and a closed loop's control signal may be endogenous beta or stimulation-entrained gamma that exists only while stimulating&quot;,&quot;proxy&quot;:&quot;where a proxy stands in for a system, the edge inherits the proxy's validity&quot;}</data></edge>
