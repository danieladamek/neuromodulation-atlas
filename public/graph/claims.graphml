    <edge id="C0215" source="adjunctive-d-cycloserine-with-intermittent-theta-050zkah" target="antidepressant-response-in-major-depressive-diso-1xmb521"><data key="e_claim_id">C0215</data><data key="e_predicate">increases</data><data key="e_refs">190</data><data key="e_status">supported</data><data key="e_evidence">human-interventional</data><data key="e_level">clinical</data><data key="e_species">human</data><data key="e_section">v0-6-cellular-responses</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;design&quot;:&quot;randomised placebo-controlled trial&quot;,&quot;n&quot;:&quot;50 participants&quot;,&quot;drug&quot;:&quot;D-cycloserine 100 mg during the first two weeks&quot;,&quot;stimulation&quot;:&quot;four weeks of iTBS&quot;,&quot;madrs_difference&quot;:&quot;6.15 points greater reduction than placebo&quot;,&quot;hedges_g&quot;:&quot;0.99&quot;,&quot;response&quot;:&quot;73.9% versus 29.3%&quot;,&quot;remission&quot;:&quot;39.1% versus 4.2%&quot;}</data></edge>
