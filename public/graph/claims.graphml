    <edge id="C0218" source="gating-by-reduced-intracortical-inhibition-durin-0jho4tq" target="cortical-excitability-during-motor-practice-1u6ua9m"><data key="e_claim_id">C0218</data><data key="e_predicate">increases</data><data key="e_refs">102;103</data><data key="e_status">supported</data><data key="e_evidence">consensus</data><data key="e_level">cellular</data><data key="e_species">human</data><data key="e_section">v0-6-cellular-responses</data><data key="e_volume">v0</data><data key="e_synthesis">false</data><data key="e_parameters">{&quot;distinction&quot;:&quot;gating briefly raises excitability during practice by reducing intracortical inhibition, whereas homeostatic metaplasticity lowers the plasticity threshold by first reducing activity&quot;,&quot;criteria&quot;:&quot;a consensus paper sets the criteria for calling a human result homeostatic at all&quot;}</data></edge>
